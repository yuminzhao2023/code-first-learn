{
  "name": "code-first-observability-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "docs:check": "node scripts/check-docs.mjs",
    "test:docs": "node --test scripts/check-docs.test.mjs",
    "lint": "eslint src tests *.config.ts --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test:e2e": "playwright test tests/behavior.spec.ts",
    "test:e2e:preview": "npm run build && playwright test --config=playwright.preview.config.ts",
    "test:visual": "playwright test tests/visual.spec.ts",
    "test:visual:update": "node scripts/run-visual.mjs --update-snapshots",
    "test:visual:docker": "node scripts/run-visual.mjs",
    "check": "npm run docs:check && npm run test:docs && npm run lint && npm run format:check && npm run typecheck && npm run test:e2e:preview",
    "test": "npm run test:e2e"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "mdast-util-from-markdown": "^2.1.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "minimatch@>=7 <11": "11.0.6"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
